# ==============================================================================
# Synthetix Environment Variables Example
# Copy this file to .env.local and fill in your values.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Obtain from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Database (Supabase PostgreSQL + Prisma) ───────────────────────────────────
# DATABASE_URL: Transaction pooler connection string (Port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct session connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Obtain from Google AI Studio (https://aistudio.google.com/)
# Requires a Google Cloud project with billing enabled for full quota
GEMINI_API_KEY=AIzaSy_placeholder

# ── Arcjet Security ───────────────────────────────────────────────────────────
# Obtain from Arcjet Dashboard (https://arcjet.com)
# Set ARCJET_ENV to "development" for local development (enables DRY_RUN mode)
ARCJET_KEY=ajkey_placeholder
ARCJET_ENV=development

# ── File Storage (Supabase Storage) ───────────────────────────────────────────
# Obtain from Supabase Project Settings -> API
# Ensure a public bucket named "workspace-images" is created in Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_placeholder_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ_placeholder_publishable_key

# ── Vercel 1-Click Deployment ─────────────────────────────────────────────────
# Obtain personal access token from Vercel Account Settings -> Tokens
VERCEL_TOKEN=vcp_placeholder

# ── Real-Time Multiplayer (Liveblocks) ────────────────────────────────────────
# Obtain from Liveblocks Dashboard (https://liveblocks.io)
LIVEBLOCKS_SECRET_KEY=sk_prod_placeholder
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_prod_placeholder

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Set to your Clerk user ID (e.g., user_2xxx...), or "auto" to make the first registered user admin
ADMIN_CLERK_ID=auto

